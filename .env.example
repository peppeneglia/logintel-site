# Base URL of the Route Intelligence prediction API (no trailing slash).
# Leave empty to run the Route Predictor with built-in sample data.
VITE_API_BASE_URL=

# Supabase project used for lead capture (contact form + report request).
# Leave empty to disable lead capture: forms still work in demo mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
